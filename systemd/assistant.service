[Unit]
Description=Elaria — personal AI assistant daemon (Phase 0)
After=network-online.target pipewire.service
Documentation=file:%h/Elaria/assistant-blueprint.md
# §4.4 crash-loop protection: three starts a minute, then stop. A 679-restart
# storm once ran on systemd's default RestartSec=100ms with no start limits —
# a crash-loop must be impossible by construction.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
# The key lives ONLY in this file (0600), outside the repo (Step 1).
# Optional at Phase 0: no file => GEMINI_MODE=mock, daemon still runs.
EnvironmentFile=-%h/.config/assistant/gemini.env
# Install/update from ~/Elaria: uv sync (runtime + dev are the default set).
# ~/.local/bin/assistd must link to ~/Elaria/.venv/bin/assistd; see GETTING-STARTED.md.
# Optional ONLY: uv sync --extra embeddings (semantic recall),
# uv sync --extra diarize (speaker post-pass), uv sync --extra voice (ONNX wake).
# Repeat chosen extra flags on updates. Wake needs a real .onnx + ECAPA scorer;
# missing inference/model = wake word paused, not a daemon startup dependency.
ExecStart=%h/.local/bin/assistd
Restart=on-failure
RestartSec=5
# §4.4 + §4.8: the schema lines on stdout are the journal sensor.
StandardOutput=journal
# Children (player, pw-record) die with the daemon two ways: systemd's default
# KillMode=control-group for `systemctl stop`, and PR_SET_PDEATHSIG set on each
# spawn for a crash, an OOM kill or a manual `kill -9` (VB-10). Do NOT set
# KillMode=process — it would reintroduce the orphaned-microphone case.
KillMode=control-group
TimeoutStopSec=5
# Light hardening that doesn't fight a personal desktop tool. filesystem
# access to $HOME is the product (§3.7), so no ProtectHome here.
NoNewPrivileges=true
PrivateTmp=true
# Crash leaves nothing (wake-knock package §4): no core dumps from the
# daemon or its children — wake audio in RAM must not leak through a crash.
# `assist doctor` / `assist hotword status` report this as checkable.
LimitCORE=0

[Install]
WantedBy=default.target
