[Unit]
Description=Elaria console panel (Quickshell, one shared conversation)
After=graphical-session.target assistant.service
PartOf=graphical-session.target

[Service]
Type=simple
# Adjust -p to wherever you checked out / installed the ui/ tree.
ExecStart=/usr/bin/quickshell -p %h/Elaria/ui/quickshell/console
ExecStopPost=%h/Elaria/scripts/event-console-fallback.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
